{
  "$schema": "./schema.json",
  "name": "vyro.submit_url",
  "version": 1,
  "site": "vyro",
  "status": "UNVERIFIED",
  "description": "Vyro: submit a live post URL to a campaign the account has joined. UNVERIFIED selectors.",
  "params": {
    "id": { "type": "string", "required": true, "description": "campaign id on Vyro" },
    "url": { "type": "string", "required": true, "description": "the live post URL" },
    "step_delay_ms": { "type": "array" }
  },
  "steps": [
    { "action": "navigate", "url": "https://vyro.com/campaigns/{{id|url}}" },
    { "action": "click", "text": "Submit", "note": "opens the submission form" },
    { "action": "type", "selector": "input[name=url], input[type=url], input[placeholder*='link' i]", "value": "{{url}}" },
    { "action": "click", "selector": "form button[type=submit]", "final": true },
    { "action": "read_text", "selector": "[data-testid=submission-status], [role=status]", "save_as": "status", "optional": true, "timeout_ms": 20000 }
  ],
  "returns": []
}
