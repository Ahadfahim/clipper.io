{
  "$schema": "./schema.json",
  "name": "whop.session_check",
  "version": 2,
  "site": "whop",
  "status": "verified",
  "description": "Whop: is this Chrome profile logged in? whop.com/home sends a logged-out visitor to the login page, which ends the run as a 'login' challenge.",
  "params": { "step_delay_ms": { "type": "array" } },
  "steps": [
    { "action": "navigate", "url": "https://whop.com/home/" },
    { "action": "wait_for", "selector": "a[aria-label=Personal], a[href='/home/']", "timeout_ms": 30000 },
    { "action": "query", "selector": "button[aria-label=Menu] img, a[aria-label=Personal]", "exists": true, "save_as": "logged_in" }
  ],
  "returns": ["logged_in"]
}