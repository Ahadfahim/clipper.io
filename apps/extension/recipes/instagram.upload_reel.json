{
  "$schema": "./schema.json",
  "name": "instagram.upload_reel",
  "version": 1,
  "site": "instagram",
  "status": "UNVERIFIED",
  "description": "Instagram web: New post → attach the clip as a Reel → caption → Share, then read the newest reel link from the profile. UNVERIFIED selectors.",
  "start_url": "https://www.instagram.com/",
  "params": {
    "file_url": { "type": "string", "required": true },
    "file_name": { "type": "string" },
    "title": { "type": "string" },
    "caption": { "type": "string", "required": true },
    "hashtags": { "type": "array" },
    "schedule_at": { "type": "string", "description": "not supported on the web: posts now" },
    "handle": { "type": "string", "required": true },
    "step_delay_ms": { "type": "array" }
  },
  "steps": [
    { "action": "navigate", "url": "https://www.instagram.com/" },
    { "action": "click", "selector": "svg[aria-label='New post'], [aria-label='New post']" },
    { "action": "click", "text": "Post", "optional": true, "note": "newer menus ask Post / Live / Ad" },
    { "action": "attach_file", "selector": "input[type=file][accept*=video], form input[type=file]", "file": "{{file_url}}", "name": "{{file_name}}" },
    { "action": "click", "text": "OK", "optional": true, "note": "'Video posts are now shared as reels' notice" },
    { "action": "click", "text": "Next", "timeout_ms": 120000, "note": "crop" },
    { "action": "click", "text": "Next", "note": "edit" },
    { "action": "type", "selector": "div[aria-label='Write a caption...'][contenteditable=true], textarea[aria-label='Write a caption...']", "value": "{{caption}} {{hashtags|tags}}" },
    { "action": "click", "text": "Share", "final": true },
    { "action": "wait_for", "text": "Your reel has been shared", "timeout_ms": 300000, "optional": true },
    { "action": "navigate", "url": "https://www.instagram.com/{{handle|noat}}/reels/" },
    { "action": "read_text", "selector": "a[href*='/reel/']", "attr": "href", "save_as": "post_url", "timeout_ms": 30000 }
  ],
  "returns": ["post_url"]
}
