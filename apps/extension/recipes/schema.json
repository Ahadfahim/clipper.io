{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper-companion-recipe",
  "title": "Clipper Companion recipe",
  "description": "A versioned list of steps the Companion extension runs in the user's own logged-in Chrome tab. Steps stop on any CAPTCHA, verification or login screen (never solved).",
  "type": "object",
  "required": ["name", "version", "site", "status", "description", "params", "steps", "returns"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "site": { "enum": ["youtube", "tiktok", "instagram", "x", "vyro", "whop"] },
    "status": { "enum": ["UNVERIFIED", "verified"], "description": "UNVERIFIED until run against the real site (dry run); verified once it has been." },
    "description": { "type": "string" },
    "start_url": { "type": "string", "format": "uri" },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["string", "number", "boolean", "array"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "returns": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "selector": { "type": "string" }, "attr": { "type": "string", "description": "read this attribute instead of the text; innerText reads the rendered text" }, "regex": { "type": "string" }, "text": { "type": "boolean" }, "all": { "type": "boolean", "description": "every match: with a regex, every capture (comma-joined); without, the texts joined with ' | '" } }
    },
    "open_each": {
      "type": "object",
      "required": ["wait_for"],
      "additionalProperties": false,
      "description": "query + all: open each match (click), read its panel and the URL, close it (Escape or close). For lists whose items open a panel instead of linking somewhere.",
      "properties": {
        "click": { "type": "string", "description": "what to click inside each match (default: the match)" },
        "wait_for": { "type": "string", "description": "what shows once it's open" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
        "url_fields": { "type": "object", "additionalProperties": { "type": "string" }, "description": "name -> regex on the URL while it's open (first group)" },
        "close": { "type": "string", "description": "a close button, or history.back when the item opened a page; default: press Escape" },
        "settle_ms": { "type": "integer", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["navigate", "wait_for", "query", "click", "type", "attach_file", "read_text", "screenshot", "snapshot"] },
        "selector": { "type": "string" },
        "text": { "type": "string", "description": "match an element by its visible text" },
        "value": { "type": "string", "description": "type: text to enter; {{param}} and {{param|filter}} are filled in" },
        "url": { "type": "string" },
        "file": { "type": "string", "description": "attach_file: clip URL on the local core (127.0.0.1 only)" },
        "name": { "type": "string" },
        "clear": { "type": "boolean" },
        "attr": { "type": "string" },
        "all": { "type": "boolean" },
        "exists": { "type": "boolean" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
        "save_as": { "type": "string" },
        "regex": { "type": "string" },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "optional": { "type": "boolean" },
        "final": { "type": "boolean", "description": "the irreversible click (publish/submit); dry runs stop before it" },
        "when": { "type": "string", "description": "run only if this param is set" },
        "note": { "type": "string" },
        "open_each": { "$ref": "#/$defs/open_each" }
      }
    }
  }
}
