{
  "manifest_version": 3,
  "name": "Clipper Companion",
  "version": "0.1.0",
  "description": "Lets Clipper on this PC upload your approved clips and read your marketplace campaigns in your own logged-in Chrome tabs.",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "service_worker.js", "type": "module" },
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://studio.youtube.com/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://x.com/*",
    "https://*.vyro.com/*",
    "https://vyro.com/*",
    "https://whop.com/*",
    "https://*.whop.com/*"
  ],
  "options_page": "options.html",
  "action": { "default_title": "Clipper Companion", "default_popup": "options.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
