{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "0.1.0",
  "identifier": "io.clipper.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Clipper",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": true,
        "resizable": true,
        "center": true,
        "theme": null,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8765 ws://127.0.0.1:8765",
        "img-src": "'self' data: blob: http://127.0.0.1:8765",
        "media-src": "'self' blob: http://127.0.0.1:8765",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Agent-run clipping for Vyro and Whop",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/clipper-core"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
